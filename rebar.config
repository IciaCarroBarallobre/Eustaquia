{minimum_rebar_version, "3.24.0"}.

{deps, [
    grisp,
    {epmd, {git, "https://github.com/erlang/epmd", {ref, "4d1a59"}}}
]}.

{erl_opts, [debug_info]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown,
        no_return
    ]},
    {plt_apps, top_level_deps}
]}.

{plugins, [rebar3_grisp]}.

{grisp, [
    {otp, [
        {version, "27"}
    ]},
    {deploy, [
        {destination, "/Volumes/GRISP"}
    ]}
]}.

{shell, [{apps, []}]}.

{relx, [
    {release, {eustaquia, "0.1.0"}, [
        {epmd, none},
        eustaquia
    ]}
]}.

{project_plugins, [{rebar3_ex_doc, "0.2.31"}]}.
{hex, [{doc, #{provider => ex_doc}}]}.
{ex_doc, [
    {extras, [
        {"CHANGELOG.md", #{title => "Changelog"}},
        {"README.md", #{title => "Overview"}},
        {"LICENSE", #{title => "License"}},
        {"docs/IMPLEMENTATION.md", #{title => "Implementation guide"}},
        {"docs/IMPLEMENTACION.md", #{title => "Guia de implementacion (ES)"}},
        {"docs/WIRING.md", #{title => "Wiring guide"}}
    ]},
    {main, "README.md"},
    {source_url, "https://github.com/IciaCarroBarallobre/eustaquia"},
    {assets, #{"assets" => "assets"}},
    {with_mermaid, "10.2.4"}
]}.
